# Supabase (required for donation registration and auth middleware)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Client-side Supabase values used by Vite
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: public production URL used by the donation notification integration
PUBLIC_SITE_URL=

# Volunteer form e-mail delivery (server-side only)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
VOLUNTEER_NOTIFY_EMAIL=sede.institutoafas@gmail.com
